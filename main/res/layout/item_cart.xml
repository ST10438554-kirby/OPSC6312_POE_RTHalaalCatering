<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp"
    android:layout_marginBottom="14dp"
    android:background="@drawable/card_background"
    android:elevation="2dp">

    <!-- Product details -->
    <TextView
        android:id="@+id/tvCartProductName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Milk Tart"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="@color/rt_text_primary" />

    <TextView
        android:id="@+id/tvCartCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Sweet Treats"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/rt_primary" />

    <TextView
        android:id="@+id/tvCartPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:text="R 5.00 each"
        android:textSize="14sp"
        android:textColor="@color/rt_text_secondary" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="#EAEAEA" />

    <!-- Quantity controls -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:text="QUANTITY"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:textColor="@color/rt_text_secondary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/etCartQuantity"
            android:layout_width="75dp"
            android:layout_height="48dp"
            android:inputType="number"
            android:gravity="center"
            android:text="20"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/rt_text_primary"
            android:background="@drawable/button_outline_background"
            android:selectAllOnFocus="true"
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/btnUpdateQuantity"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="UPDATE QUANTITY"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/rt_text_white"
            android:backgroundTint="@color/rt_primary"
            android:stateListAnimator="@null" />

    </LinearLayout>

    <!-- Subtotal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:paddingTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Item subtotal"
            android:textSize="14sp"
            android:textColor="@color/rt_text_secondary" />

        <TextView
            android:id="@+id/tvCartSubtotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="R 100.00"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/rt_primary" />

    </LinearLayout>

    <!-- Remove item -->
    <Button
        android:id="@+id/btnRemove"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_gravity="end"
        android:layout_marginTop="5dp"
        android:text="REMOVE ITEM"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/rt_error"
        android:backgroundTint="@android:color/transparent"
        android:stateListAnimator="@null" />

</LinearLayout>
