<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rt_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Back button -->
        <TextView
            android:id="@+id/tvBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="←  Back to Menu"
            android:textColor="@color/rt_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <!-- Product image -->
        <ImageView
            android:id="@+id/ivProductImage"
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/card_background"
            android:contentDescription="Product image"
            android:scaleType="centerCrop"
            android:padding="4dp" />

        <!-- Product information -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="vertical">

            <!-- Category -->
            <TextView
                android:id="@+id/tvCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sweet Treats"
                android:textColor="@color/rt_secondary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Product name -->
            <TextView
                android:id="@+id/tvProductName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Milk Tart"
                android:textColor="@color/rt_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- Description -->
            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:lineSpacingExtra="5dp"
                android:text="Product description"
                android:textColor="@color/rt_text_secondary"
                android:textSize="16sp" />

            <!-- Price -->
            <TextView
                android:id="@+id/tvPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="R 5.00"
                android:textColor="@color/rt_primary"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- Minimum quantity -->
            <TextView
                android:id="@+id/tvMinimum"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Minimum quantity: 20"
                android:textColor="@color/rt_text_secondary"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Quantity section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/card_background">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Choose your quantity"
                android:textColor="@color/rt_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etQuantity"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/rt_border"
                android:hint="Enter quantity"
                android:inputType="number"
                android:padding="15dp"
                android:text="20"
                android:textColor="@color/rt_text_primary" />

        </LinearLayout>

        <!-- Add to cart -->
        <Button
            android:id="@+id/btnAddToCart"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="@color/rt_primary"
            android:text="ADD TO CART"
            android:textColor="@color/rt_text_white"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
