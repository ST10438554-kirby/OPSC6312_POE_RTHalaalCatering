<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/rt_background">

    <!-- Main scrollable content -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivLogo"
                    android:layout_width="65dp"
                    android:layout_height="65dp"
                    android:src="@drawable/rt_catering_logo"
                    android:scaleType="fitCenter"
                    android:contentDescription="R and T Halaal Catering logo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:id="@+id/tvWelcome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="WELCOME BACK!"
                        android:textColor="@color/rt_text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="R&amp;T Catering"
                        android:textColor="@color/rt_primary"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvProfileIcon"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/logo_background"
                    android:gravity="center"
                    android:text="R&amp;T"
                    android:textColor="@color/rt_text_white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Hero banner -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginTop="25dp"
                android:background="@drawable/home_banner_background"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Something delicious&#10;is waiting for you!"
                    android:textColor="@color/rt_text_white"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="Make your next celebration extra special with our catering."
                    android:textColor="@color/rt_text_white"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnBrowseMenu"
                    android:layout_width="wrap_content"
                    android:layout_height="43dp"
                    android:layout_marginTop="14dp"
                    android:backgroundTint="@color/rt_secondary"
                    android:text="EXPLORE MENU"
                    android:textColor="@color/rt_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Menu heading -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="Explore Our Menu"
                android:textColor="@color/rt_text_primary"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Find something delicious for every occasion."
                android:textColor="@color/rt_text_secondary"
                android:textSize="13sp" />

            <!-- Categories -->

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/categorySweet"
                        android:layout_width="125dp"
                        android:layout_height="105dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/category_background"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🍩"
                            android:textSize="27sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="Sweet Treats"
                            android:textColor="@color/rt_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/categorySavoury"
                        android:layout_width="125dp"
                        android:layout_height="105dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/category_background"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🥐"
                            android:textSize="27sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="Savoury Treats"
                            android:textColor="@color/rt_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/categoryPlatters"
                        android:layout_width="125dp"
                        android:layout_height="105dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/category_background"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🍱"
                            android:textSize="27sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="Platters"
                            android:textColor="@color/rt_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/categoryPots"
                        android:layout_width="125dp"
                        android:layout_height="105dp"
                        android:background="@drawable/category_background"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🍲"
                            android:textSize="27sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="Catering Pots"
                            android:textColor="@color/rt_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </HorizontalScrollView>

            <!-- Popular options -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="Popular Catering Options"
                android:textColor="@color/rt_text_primary"
                android:textSize="21sp"
                android:textStyle="bold" />

            <!-- Party platters -->

            <LinearLayout
                android:id="@+id/btnPopularPlatters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:background="@drawable/card_background"
                android:orientation="vertical"
                android:padding="20dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🍽️  PARTY PLATTERS"
                    android:textColor="@color/rt_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="Delicious sweet and savoury selections, perfect for sharing with family and friends."
                    android:textColor="@color/rt_text_secondary"
                    android:textSize="14sp"
                    android:lineSpacingExtra="3dp" />

            </LinearLayout>

            <!-- Catering packages -->

            <LinearLayout
                android:id="@+id/btnPopularPackages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/card_background"
                android:orientation="vertical"
                android:padding="20dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎉  CATERING PACKAGES"
                    android:textColor="@color/rt_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="Explore catering options for birthdays, weddings, showers and special celebrations."
                    android:textColor="@color/rt_text_secondary"
                    android:textSize="14sp"
                    android:lineSpacingExtra="3dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Bottom navigation -->

    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="@color/rt_surface"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌂&#10;HOME"
            android:textColor="@color/rt_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/navMenu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="☷&#10;MENU"
            android:textColor="@color/rt_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/navCart"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🛒&#10;CART"
            android:textColor="@color/rt_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/navOrders"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▤&#10;ORDERS"
            android:textColor="@color/rt_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="●&#10;PROFILE"
            android:textColor="@color/rt_text_secondary"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
